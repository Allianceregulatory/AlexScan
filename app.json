{
  "expo": {
    "name": "AlexScan",
    "slug": "alexscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alexscan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.allianceregulatory.alexscan",
      "infoPlist": {
        "NSCameraUsageDescription": "AlexScan uses the camera to scan product barcodes."
      }
    },
    "android": {
      "package": "com.allianceregulatory.alexscan",
      "adaptiveIcon": {
        "backgroundColor": "#1B5E4A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B5E4A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AlexScan uses the camera to scan product barcodes.",
          "microphonePermission": "AlexScan does not record audio.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "publisher": "Alliance Regulatory Limited"
    }
  }
}
